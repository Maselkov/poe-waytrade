<rml>
<head>
    <title>Price check</title>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body data-model="ui">
<div id="panel">
    <handle id="head" move_target="#document">
        <div id="close" data-if="closable" data-event-click="close">×</div>
        <div id="gear" data-event-click="open_settings"><img src="icon:gear"/></div>
        <div data-if="name != ''" data-attr-class="'title ' + rarity">{{name}}</div>
        <div data-attr-class="(name != '' ? 'base ' : 'title ') + rarity">{{base}}</div>
        <div class="subtitle" data-if="subtitle != ''">{{subtitle}}</div>
    </handle>

    <div class="status" data-if="state == 'status'" data-class-error="status_error">{{status}}</div>

    <div class="summary ninja-card" data-if="state == 'prices'">
        <div data-for="p : prices" data-attr-class="prices.size > 1 ? 'summary-line compact' : 'summary-line'">
            <img class="summary-icon" data-if="p.icon != ''" data-attr-src="'icon:' + p.icon"/>
            <div class="coin big" data-if="p.icon == ''"/>
            <div class="summary-price"><span class="label" data-if="p.label != ''">{{p.label}} </span>≈ {{p.main}} <span class="sub">{{p.sub}}</span></div>
        </div>
        <div class="summary-foot">
            <div class="summary-range">{{source}}</div>
            <div class="tag" data-if="thin != ''">{{thin}}</div>
        </div>
    </div>

    <div class="view-row" data-if="can_switch &amp;&amp; state != 'trade'">
        <div class="toggle-chip view" data-event-click="switch_view">Map check</div>
    </div>

    <div data-if="state == 'trade'">
        <div class="summary" data-if="prices.size > 0 &amp;&amp; !(searched &amp;&amp; has_summary)">
            <img class="summary-icon" data-if="ninja_icon != ''" data-attr-src="'icon:' + ninja_icon"/>
            <div class="coin big" data-if="ninja_icon == ''"/>
            <div class="summary-text">
                <div data-for="p : prices" class="summary-price"><span class="label" data-if="p.label != ''">{{p.label}} </span>≈ {{p.main}} <span class="sub">{{p.sub}}</span></div>
                <div class="summary-range">{{ninja_meta}}</div>
            </div>
            <div class="tag" data-if="thin != ''">Thin</div>
        </div>
        <div class="ninja" data-if="prices.size > 0 &amp;&amp; searched &amp;&amp; has_summary">
            <span class="ninja-source">poe.ninja</span>
            <span data-for="p : prices" class="ninja-price"><span class="label" data-if="p.label != ''">{{p.label}} </span>{{p.main}}<span class="sub" data-if="p.sub != ''"> {{p.sub}}</span></span>
        </div>
        <div data-if="searched &amp;&amp; has_summary" data-attr-class="stale ? 'summary stale' : 'summary'">
            <img class="summary-icon" data-if="summary_icon != ''" data-attr-src="'icon:' + summary_icon"/>
            <div class="coin big" data-if="summary_icon == ''"/>
            <div class="summary-text">
                <div class="summary-price">{{summary_price}} <span class="sub">{{summary_sub}}</span></div>
                <div class="summary-range">{{summary_range}}</div>
            </div>
            <div class="tag" data-if="low_value">Low value</div>
        </div>
        <div class="options">
            <div data-if="category_label != ''" data-attr-class="base_only ? 'base-toggle exact' : 'base-toggle'"
                 data-event-click="toggle_base">{{base_only ? base_label : category_label}}</div>
            <div data-if="base_preset" data-attr-class="preset_base ? 'toggle-chip preset on' : 'toggle-chip preset'"
                 data-event-click="toggle_preset">Base item</div>
            <div data-attr-class="'toggle-chip ' + corrupted" data-event-click="cycle_corrupted">{{corrupted_label}}</div>
            <div class="toggle-chip view" data-if="can_switch" data-event-click="switch_view">Map check</div>
        </div>
        <div class="filters">
            <div data-for="g : filter_groups">
                <div class="section-label">{{g.label}}</div>
                <div data-for="f : g.filters" data-attr-class="'filter sec-' + f.section + (f.enabled ? ' on' : ' off')">
                    <div class="filter-main" data-event-click="toggle_filter(f.index)">
                        <div class="mod-cell">
                            <div class="mod">{{f.label}}</div>
                            <div class="mod-full">{{f.label}}</div>
                        </div>
                        <div data-attr-class="'tier ' + f.tier">{{f.tier}}</div>
                        <div class="bounds" data-if="f.split">
                            <div class="bound" data-class-editing="f.edit_field == 0" data-event-click="edit_bounds(f.index, 0)" data-event-mousescroll="bounds_scroll(f.index, 0)">{{f.lo}}<span class="star" data-if="f.max_roll"> ★</span></div>
                            <div class="bound-gap"/>
                            <div class="bound" data-class-editing="f.edit_field == 1" data-class-no-max="f.hi_empty" data-event-click="edit_bounds(f.index, 1)" data-event-mousescroll="bounds_scroll(f.index, 1)">{{f.hi}}</div>
                        </div>
                        <div class="min" data-if="!f.split">{{f.bounds}}</div>
                    </div>
                    <div class="slider-row" data-if="f.has_slider">
                        <div class="range" data-event-mousedown="range_press(f.index)" data-event-drag="range_drag(f.index)">
                            <div class="range-inner">
                                <div class="range-track"/>
                                <div class="range-roll" data-if="!f.enabled &amp;&amp; f.roll_pct &gt;= 0" data-style-left="f.roll_pct + '%'"/>
                                <div class="range-fill" data-style-left="f.min_pct + '%'" data-style-width="(f.max_pct - f.min_pct) + '%'"/>
                                <div class="range-handle" data-style-left="f.min_pct + '%'"/>
                                <div class="range-handle" data-style-left="f.max_pct + '%'"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="results">
            <div class="error" data-if="status != ''">{{status}}</div>
            <div data-if="!searched">
                <div class="actions">
                    <div class="button" data-event-click="search">{{searching ? 'Searching…' : 'Search'}}</div>
                </div>
            </div>
            <div data-if="searched">
                <div class="stale-note" data-if="stale">Filters changed. Search again to update.</div>
                <div data-attr-class="stale ? 'listings stale' : 'listings'">
                    <div class="listing" data-for="l : listings">
                        <img class="cur-icon" data-if="l.icon != ''" data-attr-src="'icon:' + l.icon"/>
                        <div class="coin" data-if="l.icon == ''"/>
                        <div class="amount">{{l.price}} <span class="sub">{{l.sub}}</span></div>
                        <div class="gem-tag" data-if="l.tag != ''">{{l.tag}}</div>
                        <div class="count" data-if="l.count != ''">{{l.count}}</div>
                        <div class="age">{{l.age}}</div>
                        <div class="preview" data-if="l.has_preview">
                            <div class="pv-art" data-if="l.item_icon != ''"
                                 data-style-width="l.icon_w + 'dp'" data-style-height="l.icon_h + 'dp'">
                                <img data-attr-src="'icon:' + l.item_icon"
                                     data-style-width="l.icon_w + 'dp'" data-style-height="l.icon_h + 'dp'"/>
                                <img class="pv-socket" data-for="s : l.sockets" src="icon:sockets" data-attr-rect="s.rect"
                                     data-style-left="s.x + 'dp'" data-style-top="s.y + 'dp'"
                                     data-style-width="s.w + 'dp'" data-style-height="s.h + 'dp'"/>
                            </div>
                            <div data-if="l.name != ''" data-attr-class="'pv-name ' + l.rarity">{{l.name}}</div>
                            <div data-attr-class="'pv-name ' + l.rarity">{{l.base}}</div>
                            <div class="pv-meta" data-if="l.meta != ''">{{l.meta}}</div>
                            <div class="pv-divider"/>
                            <div data-for="p : l.lines" data-attr-class="'pv-line ' + p.kind">{{p.text}}<span data-if="p.tier != ''" data-attr-class="'tier ' + p.tier"> [{{p.tier}}]</span></div>
                            <div class="pv-more" data-if="l.more != ''">{{l.more}}</div>
                        </div>
                    </div>
                    <div class="empty" data-if="listings.size == 0">No listings. Turn off a filter to widen the search.</div>
                </div>
                <div class="actions">
                    <div data-attr-class="stale ? 'button' : 'button secondary'" data-event-click="search">{{searching ? 'Searching…' : 'Search again'}}</div>
                    <div class="button secondary" data-if="has_url" data-event-click="open_trade">Open on trade site</div>
                </div>
            </div>
        </div>
    </div>

    <div class="hint" data-if="hint != ''">{{hint}}</div>
</div>
</body>
</rml>
