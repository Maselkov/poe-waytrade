<rml>
<head>
    <title>Price check</title>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body data-model="ui">
<div id="panel">
    <handle id="head" move_target="#document">
        <div id="close" data-if="closable" data-event-click="close">×</div>
        <div id="gear" data-event-click="open_settings"><img src="icon:gear"/></div>
        <div data-if="name != ''" data-attr-class="'title ' + rarity">{{name}}</div>
        <div data-attr-class="(name != '' ? 'base ' : 'title ') + rarity">{{base}}</div>
        <div class="subtitle" data-if="subtitle != ''">{{subtitle}}</div>
    </handle>

    <div class="status" data-if="state == 'status'" data-class-error="status_error">{{status}}</div>

    <div class="price-card" data-class-alone="state == 'prices'" data-if="(state == 'prices' || state == 'trade') &amp;&amp; price_rows.size > 0">
        <div data-for="r : price_rows">
        <div data-attr-class="'price-row week-scope' + (r.answer ? ' answer' : '') + (r.rule ? ' rule' : '') + (r.stale ? ' stale' : '') + (r.pick >= 0 ? ' pick' : '') + (r.week_mini ? ' week-row' : '')"
             data-event-click="pick_unique(r.pick)">
            <div class="pr-text">
                <div class="pr-label">{{r.label}}</div>
                <div class="pr-meta" data-if="r.meta != '' || r.tag != '' || r.week_mini">
                    <div class="pr-meta-text week-normal" data-if="!r.week_mini">{{r.meta}}</div>
                    <div class="pr-meta-text week-normal" data-if="r.week_mini"><span data-attr-class="r.week_up ? 'week-change up' : 'week-change down'">{{r.week_change}}</span>{{r.week_after}}</div>
                    <div class="pr-meta-text week-reading"></div>
                    <div class="tag" data-if="r.tag != ''">{{r.tag}}</div>
                </div>
            </div>
            <sparkline class="spark-mini" data-if="r.week_mini" data-attr-points="r.week" data-attr-labels="r.week_labels" data-attr-dashed="r.week_dashed ? '1' : ''"/>
            <div class="pr-value" data-if="r.main != ''">
                <div class="pr-amount">{{r.main}}</div>
                <div class="pr-icon-box" data-if="r.icon != ''"><img class="pr-icon" data-attr-src="'icon:' + r.icon"/></div>
                <div class="pr-sub" data-if="r.sub != ''">· {{r.sub}}</div>
            </div>
            <div class="pr-note" data-if="r.main == ''">{{r.note}}</div>
        </div>
        <!-- One item's week, large, under its price. -->
        <div class="trend" data-if="r.week_big" data-class-stale="r.stale">
            <div class="trend-chart week-scope">
                <sparkline class="spark-big" data-attr-points="r.week" data-attr-labels="r.week_labels" data-attr-dashed="r.week_dashed ? '1' : ''" baseline="1"/>
                <div class="trend-foot week-normal">{{r.week_foot}}</div>
                <div class="trend-foot week-reading"></div>
            </div>
            <div class="trend-side" data-class-cycles="r.week_cycles" data-class-loading="r.week_loading" data-event-click="week_range(r.history_ref)">
                <div data-attr-class="r.week_up ? 'trend-badge up' : 'trend-badge down'">{{r.week_change}}</div>
                <div class="trend-days">{{r.week_days}}</div>
            </div>
        </div>
        </div>
        <div class="pr-meta pr-foot" data-if="price_foot != ''">
            <div class="pr-meta-text">{{price_foot}}</div>
            <div class="tag" data-if="foot_tag != ''">{{foot_tag}}</div>
        </div>
    </div>

    <div class="view-row" data-if="can_switch &amp;&amp; state != 'trade'">
        <div class="toggle-chip view" data-event-click="switch_view">Map check</div>
    </div>

    <div data-if="state == 'trade'">
        <div class="options">
            <div data-if="has_base" data-attr-class="'base-toggle' + (base_only ? ' on' : ' off') + (preset_base ? ' locked' : '')"
                 data-event-click="toggle_base">{{base_label}}</div>
            <div data-if="base_preset" data-attr-class="preset_base ? 'toggle-chip preset on' : 'toggle-chip preset'"
                 data-event-click="toggle_preset">Base item</div>
            <div data-if="six_link_offered" data-attr-class="six_link_on ? 'toggle-chip links on' : 'toggle-chip links'"
                 data-event-click="toggle_six_link">6-link</div>
            <div data-if="unid_offered" data-attr-class="unid_on ? 'toggle-chip unid on' : 'toggle-chip unid'"
                 data-event-click="toggle_unidentified">Unidentified</div>
            <div data-attr-class="'toggle-chip corr ' + corrupted_kind + (corrupted_on ? ' on' : '')" data-event-click="toggle_corrupted">{{corrupted_label}}</div>
            <div class="toggle-chip view" data-if="can_switch" data-event-click="switch_view">Map check</div>
        </div>
        <div class="filters">
            <div data-for="g : filter_groups">
                <div class="section-label">{{g.label}}</div>
                <div data-for="f : g.filters" data-attr-class="'filter sec-' + f.section + (f.enabled ? ' on' : ' off')">
                    <div class="filter-main" data-event-click="toggle_filter(f.index)">
                        <div class="mod-cell">
                            <div class="mod">{{f.label}}</div>
                            <div class="mod-full">{{f.label}}</div>
                        </div>
                        <div class="increased" data-if="f.increased != ''">{{f.increased}}</div>
                        <div data-attr-class="'tier ' + f.tier">{{f.tier}}</div>
                        <div class="bounds" data-if="f.split">
                            <div class="bound" data-class-editing="f.edit_field == 0" data-event-click="edit_bounds(f.index, 0)" data-event-mousescroll="bounds_scroll(f.index, 0)"><span class="star" data-if="f.max_roll">★</span>{{f.lo}}</div>
                            <div class="bound-gap"/>
                            <div class="bound" data-class-editing="f.edit_field == 1" data-class-no-max="f.hi_empty" data-event-click="edit_bounds(f.index, 1)" data-event-mousescroll="bounds_scroll(f.index, 1)">{{f.hi}}</div>
                        </div>
                        <div class="min" data-if="!f.split">{{f.bounds}}</div>
                    </div>
                    <div class="slider-row" data-if="f.has_slider">
                        <div class="range" data-event-mousedown="range_press(f.index)" data-event-drag="range_drag(f.index)">
                            <div class="range-inner">
                                <div class="range-track"/>
                                <div class="range-fill" data-style-left="f.min_pct + '%'" data-style-width="(f.max_pct - f.min_pct) + '%'"/>
                                <div class="range-roll" data-if="f.roll_pct &gt;= 0" data-style-left="f.roll_pct + '%'"/>
                                <div class="range-handle" data-style-left="f.min_pct + '%'"/>
                                <div class="range-handle" data-if="f.has_max" data-style-left="f.max_pct + '%'"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="results">
            <div class="error" data-if="status != ''">{{status}}</div>
            <div data-if="!searched">
                <div class="actions">
                    <div class="button" data-event-click="search">{{searching ? 'Searching…' : 'Search'}}</div>
                    <div class="button secondary" data-event-click="open_trade">Open on trade site</div>
                </div>
            </div>
            <div data-if="searched">
                <div class="stale-note" data-if="stale">Filters changed. Search again to update.</div>
                <div data-attr-class="stale ? 'listings stale' : 'listings'">
                    <div class="list-head" data-if="listings.size > 0 || orbs_only">
                        <div class="amount"><div class="price-head" data-event-click="toggle_orbs_only">
                            <div>Price</div>
                            <img class="head-icon" data-if="orbs_only" data-attr-src="'icon:' + small_unit"/>
                            <img class="head-icon" data-if="orbs_only" src="icon:divine"/>
                            <div class="col-full">{{orbs_only ? 'Only ' + small_unit + ' and divine · click for any currency' : 'Any currency · click for ' + small_unit + ' and divine only'}}</div>
                        </div></div>
                        <div class="col gem" data-if="gem_level_col">Level</div>
                        <div class="col gem" data-if="gem_quality_col">Quality</div>
                        <div class="col head-col" data-for="c : list_cols">
                            <div class="col-name">{{c.name}}</div>
                            <div class="col-full">{{c.full}}</div>
                        </div>
                        <div class="count-cell">{{list_more}}</div>
                        <div class="age">Listed</div>
                    </div>
                    <div class="listing" data-for="l : listings">
                        <div class="amount">
                            <div class="amount-value">{{l.price}}</div>
                            <img class="cur-icon" data-if="l.icon != ''" data-attr-src="'icon:' + l.icon"/>
                            <div class="amount-sub" data-if="l.sub != ''">· {{l.sub}}</div>
                        </div>
                        <div class="col gem" data-if="gem_level_col">{{l.gem_level}}</div>
                        <div class="col gem" data-if="gem_quality_col">{{l.gem_quality}}</div>
                        <div class="col value" data-for="v : l.cols">{{v}}</div>
                        <div class="count-cell"><div class="count" data-if="l.count != ''">{{l.count}}</div></div>
                        <div class="age" data-class-old="l.old">{{l.age}}</div>
                        <div class="preview" data-if="l.has_preview">
                            <div class="pv-art" data-if="l.item_icon != ''"
                                 data-style-width="l.icon_w + 'dp'" data-style-height="l.icon_h + 'dp'">
                                <img data-attr-src="'icon:' + l.item_icon"
                                     data-style-width="l.icon_w + 'dp'" data-style-height="l.icon_h + 'dp'"/>
                                <img class="pv-socket" data-for="s : l.sockets" src="icon:sockets" data-attr-rect="s.rect"
                                     data-style-left="s.x + 'dp'" data-style-top="s.y + 'dp'"
                                     data-style-width="s.w + 'dp'" data-style-height="s.h + 'dp'"/>
                            </div>
                            <div data-if="l.name != ''" data-attr-class="'pv-name ' + l.rarity">{{l.name}}</div>
                            <div data-attr-class="'pv-name ' + l.rarity">{{l.base}}</div>
                            <div class="pv-meta" data-if="l.meta != ''">{{l.meta}}</div>
                            <div class="pv-divider"/>
                            <div data-for="p : l.lines" data-attr-class="'pv-line ' + p.kind">{{p.text}}<span data-if="p.tier != ''" data-attr-class="'tier ' + p.tier"> [{{p.tier}}]</span></div>
                            <div class="pv-more" data-if="l.more != ''">{{l.more}}</div>
                        </div>
                    </div>
                    <div class="empty" data-if="listings.size == 0">No listings. Turn off a filter to widen the search.</div>
                </div>
                <div class="actions">
                    <div data-attr-class="stale ? 'button' : 'button secondary'" data-event-click="search">{{searching ? 'Searching…' : 'Search again'}}</div>
                    <div class="button secondary" data-event-click="open_trade">Open on trade site</div>
                </div>
            </div>
        </div>
    </div>

    <div class="hint" data-if="hint != ''">{{hint}}</div>
</div>
</body>
</rml>
