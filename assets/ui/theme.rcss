/* Theme for the overlay. `@define $name value;` lines are substituted by
   the loader (RCSS has no variables). Edit live with POE_WAYTRADE_UI_DIR. */

@define $accent #5b4fb0;
@define $accent-text #e4e0fa;
@define $panel #111317;
@define $panel-border #262a31;
@define $divider #1f232a;
@define $text #d7dae0;
@define $text-strong #f3f4f6;
@define $text-muted #8b919c;
@define $text-faint #5d636e;
@define $chip #1b1f26;
@define $off #2c313a;
@define $price #f0d68a;
@define $mod #aab8ff;
@define $warn-bg #2a1f12;
@define $warn #e2a35a;
@define $error #f0857a;
@define $danger #e0625a;
@define $danger-bg #3a1716;
@define $good #6cc08b;
@define $good-bg #13291d;

@define $normal #c8c8c8;
@define $magic #8888ff;
@define $rare #ffff77;
@define $unique #d0743a;
@define $gem #1ba29b;
@define $currency #c8bfa8;
@define $card #c8c8c8;

body, div, span, handle { display: block; }
span { display: inline; }

body {
    position: absolute;
    left: 40dp;
    top: 40dp;
    width: 370dp;
    font-family: Inter;
    font-size: 12dp;
    color: $text;
}

#panel {
    background-color: $panel;
    border: 1dp $panel-border;
    border-radius: 12dp;
}

/* Header: the item, PoE-tooltip style. */
#head {
    position: relative;
    padding: 12dp 28dp 10dp;
    text-align: center;
    border-bottom: 1dp $divider;
}
#close {
    position: absolute;
    right: 8dp;
    top: 6dp;
    width: 20dp;
    height: 20dp;
    line-height: 20dp;
    text-align: center;
    font-size: 15dp;
    color: $text-faint;
    border-radius: 6dp;
    cursor: pointer;
}
#close:hover { color: $text-strong; background-color: $chip; }

.title { font-family: Cinzel; font-size: 17dp; letter-spacing: 0.5dp; }
.base { font-family: Cinzel; font-size: 13dp; }
.subtitle { font-size: 11dp; color: $text-muted; margin-top: 3dp; }

.normal { color: $normal; }
.magic { color: $magic; }
.rare { color: $rare; }
.unique { color: $unique; }
.gem { color: $gem; }
.currency { color: $currency; }
.card { color: $card; }

.section { padding: 8dp 14dp 12dp; }
.status { padding: 12dp 14dp; color: $text-muted; text-align: center; }
.error { color: $error; }

/* poe.ninja prices */
.price { display: flex; align-items: baseline; justify-content: center; padding: 3dp 0; }
.price .label { color: $text-muted; margin-right: 8dp; }
.price .main { font-size: 22dp; font-weight: 500; color: $price; }
.price.compact .main { font-size: 15dp; }
.price .sub { font-size: 12dp; color: $text-muted; margin-left: 8dp; }
.meta { display: flex; justify-content: center; margin-top: 6dp; font-size: 11dp; color: $text-faint; }
.tag { background-color: $warn-bg; color: $warn; border-radius: 6dp; padding: 2dp 8dp; margin-right: 8dp; }

/* Trade filters */
.filters { padding: 6dp 14dp; }
/* A filter row is its own toggle: ticked rows get an accent bar and lit
   text, unticked ones are dimmed. Tier and value sit in columns on the right;
   the mod text stays on one line. */
.filter { margin: 0 -14dp 0 -14dp; padding: 0 14dp 0 11dp; border-left: 3dp transparent; }
.filter.on { border-left-color: $accent; background-color: #16171f; }
.filter:hover { background-color: #1a1c23; }
.filter-main { display: flex; align-items: center; padding: 4dp 0; cursor: pointer; }
.mod { flex: 1 1 0; min-width: 0; color: $mod; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.filter.off .mod { color: $text-muted; }
.filter-main .tier { width: 22dp; flex-shrink: 0; text-align: right; font-size: 11dp; color: $text-faint; margin-left: 6dp; }
.min { flex-shrink: 0; min-width: 40dp; text-align: center; background-color: $chip; border: 1dp transparent; border-radius: 6dp; padding: 1dp 6dp; color: $text-strong; margin-left: 8dp; }
.filter.off .min { background-color: transparent; color: $text-faint; }
.star { color: $price; }
.filter.off .star { color: #8a7a4c; }

/* Min/max range slider: a slim strip under every filter with a range, so
   ticking a row never moves the rows below. Unticked, it's a faint track
   with a mark where the item's own value sits; ticked, it gets its fill and
   handles. The handles centre on their value; the padding keeps both ends
   reachable. A maximum at the right end means none. */
.slider-row { padding: 0 0 3dp 0; margin-top: -2dp; }
.range { height: 12dp; padding: 0 7dp; drag: drag; cursor: pointer; }
.range-inner { position: relative; height: 12dp; }
.range-track, .range-fill { position: absolute; top: 5dp; height: 2dp; border-radius: 1dp; }
.range-track { left: 0; right: 0; background-color: $off; }
.filter.off .range-track { background-color: #1f2128; }
.filter.off .range-fill, .filter.off .range-handle { display: none; }
.range-fill { background-color: $accent; }
.range-roll { position: absolute; top: 3dp; width: 2dp; height: 6dp; margin-left: -1dp; background-color: #4a4d5a; }
.range-handle {
    position: absolute;
    top: 0dp;
    width: 12dp;
    height: 12dp;
    margin-left: -6dp;
    border-radius: 6dp;
    background-color: $accent-text;
    border: 2dp $accent;
}
.range:hover .range-handle { background-color: #ffffff; }

.section-label { font-size: 10dp; letter-spacing: 0.5dp; color: $text-faint; margin: 6dp 0 2dp; }

/* Price summary */
.summary { display: flex; align-items: center; margin: 10dp 14dp 0; padding: 10dp 12dp; background-color: #1a1d24; border-radius: 10dp; }
.summary.stale { opacity: 0.45; }
.summary-icon { width: 30dp; height: 30dp; margin-right: 10dp; }
.coin.big { width: 26dp; height: 26dp; border-radius: 13dp; margin-right: 10dp; }
.summary-text { flex: 1; }
.summary-price { font-size: 17dp; font-weight: 500; color: $price; }
.summary-price .label { font-size: 12dp; font-weight: 400; color: $text-muted; }
.summary-price .sub { font-size: 12dp; font-weight: 400; color: $text-muted; }
.summary-range { font-size: 11dp; color: $text-muted; margin-top: 2dp; }
.summary .tag { margin: 0 0 0 8dp; }
/* Trade search options */
.options { display: flex; align-items: center; padding: 10dp 14dp 2dp; }
/* Fixed layout: labels never wrap, and the corrupted button keeps one width,
   so clicking either control doesn't move anything. The base button (like
   APT's) shows the search it's set to: "Any Gloves" or the exact base,
   outlined in the accent colour. */
.base-toggle {
    flex: 1;
    min-width: 0;
    margin-right: 8dp;
    padding: 3dp 8dp;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border: 1dp $off;
    border-radius: 8dp;
    color: $text-strong;
    cursor: pointer;
}
.base-toggle:hover { background-color: $chip; }
.base-toggle.exact { border-color: $accent; }
.toggle-chip {
    width: 78dp;
    flex-shrink: 0;
    padding: 3dp 0;
    text-align: center;
    white-space: nowrap;
    border: 1dp $off;
    border-radius: 8dp;
    color: $text-muted;
    cursor: pointer;
    transition: background-color color 0.12s linear-out;
}
.toggle-chip:hover { color: $text-strong; }
.toggle-chip.no { background-color: $good-bg; border-color: #2a5a3c; color: $good; }
.toggle-chip.yes { background-color: $danger-bg; border-color: #6a2a26; color: $danger; }
/* "Base item": APT's crafting-base preset, offered for fractured,
   influenced, synthesised and high item level bases. */
.toggle-chip.preset { width: 70dp; margin-right: 8dp; }
.toggle-chip.preset.on { background-color: #2a2546; border-color: $accent; color: $accent-text; }

/* Trade results */
.results { border-top: 1dp $divider; padding: 8dp 14dp 12dp; }
.results-head { display: flex; justify-content: space-between; font-size: 11dp; color: $text-muted; margin-bottom: 4dp; }
.listing { display: flex; align-items: center; padding: 5dp 0; }
.coin { width: 12dp; height: 12dp; border-radius: 6dp; background-color: #c9a24f; margin-right: 8dp; flex-shrink: 0; }
.amount { flex: 1; color: $price; font-weight: 500; }
.cur-icon { width: 18dp; height: 18dp; margin-right: 6dp; flex-shrink: 0; }
.count { background-color: $chip; border-radius: 6dp; padding: 1dp 6dp; font-size: 11dp; color: $text; margin-left: 6dp; }
.age { width: 58dp; text-align: right; }
.amount .sub { color: $text-muted; font-weight: 400; }
.age { color: $text-faint; }
.empty { color: $text-muted; padding: 6dp 0; }

.actions { display: flex; margin-top: 8dp; }
.actions .button { margin-left: 6dp; }
.actions .button:first-child { margin-left: 0; }
.stale-note { color: $warn; font-size: 11dp; margin-bottom: 4dp; }
.listings.stale { opacity: 0.45; }
.button {
    flex: 1;
    text-align: center;
    border-radius: 8dp;
    padding: 6dp;
    font-weight: 500;
    background-color: $accent;
    color: $accent-text;
    cursor: pointer;
    transition: background-color 0.1s linear-out;
}
.button:hover { background-color: #6a5ec4; }
.button:active { background-color: #4d4296; }
.button.secondary { background-color: transparent; border: 1dp $off; color: $text; }
.button.secondary:hover { background-color: $chip; color: $text-strong; }

.hint { text-align: center; font-size: 10dp; color: $text-faint; padding: 0 0 8dp; }

/* Map check */
.verdict { margin: 10dp 14dp 0; padding: 7dp 10dp; border-radius: 8dp; font-weight: 500; }
.verdict.deadly { background-color: $danger-bg; color: $danger; }
.verdict.warning { background-color: $warn-bg; color: $warn; }
.verdict.clean { background-color: $good-bg; color: $good; }

.chips { display: flex; flex-wrap: wrap; padding: 8dp 14dp 0; }
.chip { background-color: $chip; border-radius: 6dp; padding: 2dp 8dp; margin: 0 6dp 6dp 0; color: $text-strong; }
.chip-label { color: $text-muted; }

/* A map's poe.ninja price and the switch to its price check */
.map-price { display: flex; align-items: center; padding: 0 14dp 6dp; }
.map-price-text { flex: 1; }
.map-price-value { color: $price; }
.toggle-chip.view { width: 86dp; margin-left: 8dp; }
.view-row { display: flex; justify-content: center; padding: 0 14dp 10dp; }
.view-row .toggle-chip.view { margin-left: 0; }
.profiles { display: flex; align-items: center; justify-content: flex-end; padding: 2dp 14dp 4dp; font-size: 11dp; color: $text-muted; }
.profiles-label { margin-right: 4dp; }
.profile {
    width: 26dp;
    text-align: center;
    padding: 2dp 0;
    margin-left: 4dp;
    border-radius: 6dp;
    border: 1dp $off;
    color: $text-muted;
    font-family: Cinzel;
    cursor: pointer;
}
.profile:hover { color: $text-strong; }
.profile.active { border-color: $accent; background-color: $accent; color: $accent-text; }

.mods { padding: 4dp 8dp 8dp; }
.mapmod {
    display: flex;
    align-items: center;
    padding: 6dp 8dp 6dp 9dp;
    margin-bottom: 3dp;
    border-left: 3dp transparent;
    border-radius: 6dp;
    color: $mod;
    cursor: pointer;
}
.mapmod:hover { background-color: $chip; }
.mapmod.deadly { background-color: $danger-bg; border-left-color: $danger; color: #f3c9c5; }
.mapmod.warning { background-color: $warn-bg; border-left-color: $warn; color: #f0dcc0; }
.mapmod.good { background-color: $good-bg; border-left-color: $good; color: #cfe9d8; }
.mapmod-text { flex: 1; }
.mapmod-tag { font-size: 10dp; font-weight: 500; margin-left: 8dp; }
.deadly .mapmod-tag { color: $danger; }
.warning .mapmod-tag { color: $warn; }
.good .mapmod-tag { color: $good; }

/* Debug panel */
#debug { left: auto; right: 40dp; width: 340dp; }
#debug .line { padding: 1dp 14dp; font-size: 11dp; }

/* A unique's poe.ninja price above its trade filters */
.ninja { display: flex; flex-wrap: wrap; align-items: baseline; padding: 10dp 14dp 0; color: $text-muted; }
.ninja-source { font-size: 11dp; margin-right: 8dp; }
.ninja-price { color: $price; margin-right: 10dp; }
.ninja-price .label { color: $text-muted; }
.ninja-price .sub { color: $text-muted; font-size: 11dp; }

/* Hover preview of a listed item, beside the panel (away from the inventory
   or stash it sits against), PoE-tooltip style. */
.listing { position: relative; }
.listing:hover { background-color: #171a20; }
.preview {
    display: none;
    position: absolute;
    right: 100%;
    bottom: -6dp;
    margin-right: 23dp;
    width: 280dp;
    padding: 10dp 12dp;
    background-color: $panel;
    border: 1dp $panel-border;
    border-radius: 10dp;
    text-align: center;
}
body.preview-right .preview { right: auto; left: 100%; margin-right: 0; margin-left: 23dp; }
.listing:hover .preview { display: block; }
.pv-name { font-weight: 500; font-size: 13dp; color: $normal; }
.pv-name.magic { color: $magic; }
.pv-name.rare { color: $rare; }
.pv-name.unique { color: $unique; }
.pv-meta { color: $text-muted; font-size: 11dp; margin-top: 2dp; }
.pv-divider, .pv-line.divider { height: 1dp; background-color: $divider; margin: 6dp 20dp; }
.pv-line { color: #8888ff; padding: 1dp 0; }
.pv-line.enchant { color: #b8daf2; }
.pv-line.crafted { color: #b4b4ff; }
.pv-line.fractured { color: #a29162; }
.pv-line.corrupted, .pv-line.unidentified { color: $danger; margin-top: 4dp; }
.pv-more { color: $text-faint; font-size: 11dp; margin-top: 6dp; }

/* Affix tiers: T1 a subtle gold, T2 silver, T3 bronze, lower ones grey. */
.tier.T1 { color: #c9a85a; }
.tier.T2 { color: #a9b0ba; }
.tier.T3 { color: #a87a55; }

/* Fractured mods in PoE's fractured gold, with a gold bar when ticked.
   Row classes are "sec-" + the filter's section (plain "base" would pick up
   the item header's .base style). */
.filter.sec-fractured .mod { color: #c6b07a; }
.filter.sec-fractured.on { border-left-color: #a88f52; background-color: #1a1710; }
.filter.sec-fractured.off .mod { color: #8e7f57; }
.filter.sec-fractured .range-fill { background-color: #a88f52; }
.filter.sec-fractured .range-handle { border-color: #a88f52; background-color: #efe3c2; }
.pv-line.fractured { color: #c6b07a; }
