# Builds from the local checkout this file lives in.
#   cd packaging/arch && makepkg -si
pkgname=poe-overlay
pkgver=0.1.0
pkgrel=2
pkgdesc="In-game Vulkan overlay prototype for Path of Exile (Wayland hotkeys)"
arch=('x86_64')
license=('unknown')
depends=('vulkan-icd-loader' 'wayland')
makedepends=('cmake' 'ninja' 'vulkan-headers')

_srcroot="$(realpath "$startdir/../..")"

build() {
  cmake -S "$_srcroot" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
