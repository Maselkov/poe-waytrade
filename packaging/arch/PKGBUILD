# Builds from the local checkout this file lives in.
#   cd packaging/arch && makepkg -si
pkgname=poe-waytrade
pkgver=0.17.0
pkgrel=1
pkgdesc="In-game Vulkan price-check overlay for Path of Exile on Wayland"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('vulkan-icd-loader' 'wayland' 'freetype2' 'gcc-libs' 'glibc')
makedepends=('cmake' 'ninja' 'vulkan-headers' 'wayland-protocols' 'shaderc' 'cargo')
optdepends=('chromium: trade search for rare items (or google-chrome)'
            'xdg-utils: open trade searches in your browser')
# Rust links with lld, which can't read the GCC LTO objects of C deps (ring).
options=('!lto')
install=poe-waytrade.install

_srcroot="$(realpath "$startdir/../..")"

prepare() {
  cargo fetch --locked --manifest-path "$_srcroot/daemon/Cargo.toml" \
    --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cmake -S "$_srcroot" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build

  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release --manifest-path "$_srcroot/daemon/Cargo.toml"
}

check() {
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release --manifest-path "$_srcroot/daemon/Cargo.toml"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm755 "$srcdir/target/release/poe-waytrade-daemon" "$pkgdir/usr/bin/poe-waytrade-daemon"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" \
    "$_srcroot/packaging/poe-waytrade-daemon.service" \
    "$_srcroot/packaging/poe-waytrade-daemon.socket"
}
