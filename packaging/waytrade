#!/bin/sh
# waytrade: run a game with the Waytrade overlay, like `mangohud %command%`.
#
# Steam launch options for Path of Exile or Path of Exile 2:
#   waytrade %command%
#
# This runs on the host, before Steam's runtime container starts. It turns
# the overlay layer on, uses Proton's Wayland driver (the overlay needs it;
# set PROTON_ENABLE_WAYLAND=0 to override), and runs the price daemon for as
# long as the game does. If a daemon is already serving (e.g. systemd's
# socket is enabled), that one is used and nothing extra starts.
#
# Which game it is comes from Steam's app id (SteamAppId: 238960 is Path of
# Exile, 2694490 Path of Exile 2); POE_WAYTRADE_GAME=poe1|poe2 overrides it.
# Each game has its own daemon. systemd's socket serves PoE1 only, so for
# PoE2 the daemon always runs with the game.
#
# The daemon's log goes to $XDG_STATE_HOME/poe-waytrade/daemon.log
# (daemon-poe2.log for PoE2). POE_WAYTRADE_DAEMON picks another daemon binary.

if [ $# -eq 0 ]; then
    echo "usage: waytrade <command> [args...]   (in Steam: waytrade %command%)" >&2
    exit 2
fi

export ENABLE_POE_WAYTRADE=1
if [ -z "$POE_WAYTRADE_GAME" ]; then
    case "${SteamAppId:-$SteamGameId}" in
        2694490) POE_WAYTRADE_GAME=poe2 ;;
        *) POE_WAYTRADE_GAME=poe1 ;;
    esac
fi
export POE_WAYTRADE_GAME
log=daemon.log
[ "$POE_WAYTRADE_GAME" = poe2 ] && log=daemon-poe2.log
export PROTON_ENABLE_WAYLAND="${PROTON_ENABLE_WAYLAND:-1}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/poe-waytrade"
mkdir -p "$state_dir"

# Not with Steam's preloads and libraries: the daemon (and the Chromium it
# starts for trade searches) are ordinary host programs. It exits right away
# if a daemon is already serving, and with this script otherwise.
env -u LD_PRELOAD -u LD_LIBRARY_PATH \
    "${POE_WAYTRADE_DAEMON:-poe-waytrade-daemon}" --exit-with-parent \
    >"$state_dir/$log" 2>&1 &
daemon=$!

"$@"
status=$?

kill "$daemon" 2>/dev/null
wait "$daemon" 2>/dev/null
exit "$status"
